@model Student_Housing_Management_System.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

@await Html.PartialAsync("_ErrorMessage", TempData["ErrorMessage"] as string)

<h1>Delete Student</h1>

<h4>Are you sure you want to delete this student?</h4>

<div class="mb-3">
    <p><strong>First Name:</strong> @Model.FirstName</p>
    <p><strong>Last Name:</strong> @Model.LastName</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Phone Number:</strong> @Model.PhoneNumber</p>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" name="id" value="@Model.StudentId" />

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
