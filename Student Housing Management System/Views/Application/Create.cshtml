@model Student_Housing_Management_System.Models.Application

@{
    ViewData["Title"] = "Create Application";
}

<h1>Create Application</h1>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="StudentId" class="form-label">Student ID</label>
        <input asp-for="StudentId" type="number" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="RoomId" class="form-label">Room ID</label>
        <input asp-for="RoomId" type="number" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ApplicationStatus" class="form-label">Status</label>
        <select asp-for="ApplicationStatus" class="form-select"
                asp-items="Html.GetEnumSelectList<Student_Housing_Management_System.Models.Enums.ApplicationStatus>()">
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>

</form>
