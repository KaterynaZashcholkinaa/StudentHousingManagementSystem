@model List<Student_Housing_Management_System.ViewModels.ApplicationViewModel>

@{
    ViewData["Title"] = "Applications";
}

@await Html.PartialAsync("_ErrorMessage", TempData["ErrorMessage"] as string)

<h1>Applications</h1>

<a asp-action="Create" class="btn btn-primary mb-3">
    Add Application
</a>

<table class="table">
    <thead>
        <tr>
            <th>Student</th>
            <th>Room</th>
            <th>Building</th>
            <th>Address</th>
            <th>Application Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var application in Model)
        {
            <tr>
                <td>
                    @application.StudentFirstName @application.StudentLastName
                </td>
                <td>@application.RoomNumber</td>
                <td>@application.BuildingName</td>
                <td>@application.Address</td>
                <td>@application.ApplicationDate.ToString("dd-MM-yyyy")</td>

                <td>
                    <form asp-action="EditStatus"
                          asp-route-id="@application.ApplicationId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="ApplicationId"
                               value="@application.ApplicationId" />

                        <select name="ApplicationStatus"
                                class="form-select"
                                onchange="this.form.submit()">

                            @foreach (var status in Enum.GetValues<Student_Housing_Management_System.Models.Enums.ApplicationStatus>())
                            {
                                if (status == application.ApplicationStatus)
                                {
                                    <option value="@status" selected>@status</option>
                                }
                                else
                                {
                                    <option value="@status">@status</option>
                                }
                            }
                        </select>
                    </form>
                </td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@application.ApplicationId"
                       class="btn btn-primary">
                        Details
                    </a>
                    <a asp-action="Delete"
                       asp-route-id="@application.ApplicationId"
                       class="btn btn-danger">
						Delete
					</a>
                </td>
            </tr>
        }
    </tbody>
</table>