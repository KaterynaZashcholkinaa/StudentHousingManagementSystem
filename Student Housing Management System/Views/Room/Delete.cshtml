@model Student_Housing_Management_System.Models.Room

@{
    ViewData["Title"] = "Delete Room";
}

<h1>Delete Room</h1>

<h4>Are you sure you want to delete this room?</h4>

<p><strong>Room Number:</strong> @Model.RoomNumber</p>
<p><strong>Floor:</strong> @Model.Floor</p>
<p><strong>Price:</strong> @Model.Price</p>
<p><strong>Status:</strong> @Model.RoomStatus</p>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" name="id" value="@Model.RoomId" />

    <button type="submit" class="btn btn-danger">Delete</button>

    <a asp-controller="Building"
       asp-action="Details"
       asp-route-id="@Model.BuildingId"
       class="btn btn-secondary">
        Cancel
    </a>
</form>
