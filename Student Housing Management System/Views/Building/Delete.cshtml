@model Student_Housing_Management_System.Models.Building

@{
    ViewData["Title"] = "Delete Building";
}

<h1>Delete Building</h1>

<h4>Are you sure you want to delete this building?</h4>

<p><strong>Name:</strong> @Model.Name</p>
<p><strong>Address:</strong> @Model.Address</p>

@if (Model.Rooms.Any())
{
    <div class="alert alert-warning">
        You cannot delete this building because it still contains rooms.
        Delete its rooms first.
    </div>
}
else
{
    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" name="id" value="@Model.BuildingId" />

        <button type="submit" class="btn btn-danger">Delete</button>
    </form>
}

<a asp-action="Details"
   asp-route-id="@Model.BuildingId"
   class="btn btn-secondary">
    Cancel
</a>
