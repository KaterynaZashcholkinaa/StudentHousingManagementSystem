@model Student_Housing_Management_System.Models.Building

@{
    ViewData["Title"] = "Edit Building";
}

@await Html.PartialAsync("_ErrorMessage", TempData["ErrorMessage"] as string)

<h1>Edit Building</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="BuildingId" />

    <div class="form-group mb-3">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Address" class="control-label"></label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Details"
       asp-route-id="@Model.BuildingId"
       class="btn btn-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
